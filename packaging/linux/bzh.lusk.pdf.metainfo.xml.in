<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>bzh.lusk.pdf</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Lusk PDF</name>
  <summary>Read, organize, combine, split and secure PDFs</summary>
  <summary xml:lang="fr">Lire, organiser, combiner, découper et protéger des PDF</summary>
  <developer id="bzh.lusk">
    <name>Lusk</name>
  </developer>
  <description>
    <p>
      Lusk PDF is a free PDF workbench by the Lusk association, adapted from PdfCraft. Read,
      comment on, fill in and sign PDFs; organize, combine and split pages; edit, redact,
      protect and export documents.
    </p>
    <p xml:lang="fr">
      Lusk PDF est un atelier PDF libre et gratuit de l'association Lusk, adapté de PdfCraft.
      Lisez, commentez, remplissez et signez des PDF ; organisez, combinez et découpez des pages ;
      modifiez, biffez, protégez et exportez des documents.
    </p>
  </description>
  <launchable type="desktop-id">bzh.lusk.pdf.desktop</launchable>
  <icon type="stock">bzh.lusk.pdf</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://www.lusk.bzh</url>
  <url type="bugtracker">https://github.com/declic29/Lusk_Pdf/issues</url>
  <url type="help">https://github.com/declic29/Lusk_Pdf</url>
  <url type="contact">mailto:contact@lusk.bzh</url>
  <categories>
    <category>Office</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>pdf</keyword>
    <keyword>viewer</keyword>
    <keyword>annotate</keyword>
    <keyword>forms</keyword>
    <keyword xml:lang="fr">lecteur</keyword>
    <keyword xml:lang="fr">annoter</keyword>
    <keyword xml:lang="fr">formulaire</keyword>
    <keyword xml:lang="fr">signer</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>A PDF open with its threaded comments</caption>
      <caption xml:lang="fr">Un PDF ouvert avec ses commentaires</caption>
      <image>https://raw.githubusercontent.com/storytold/pdfcraft/main/docs/images/pdfcraft-viewer.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#f8e5e6</color>
    <color type="primary" scheme_preference="dark">#a31b1f</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>pdfcraft</binary>
    <mediatype>application/pdf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
