<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Lusk PDF : les pages de l'installateur, en français. Les pages d'accueil et de fin ont en haut
       le bandeau de Lusk (logo de Lusk PDF et renard, images/banner.bmp, dessiné par
       images/generate.py) ; la page de fin propose « Lancer Lusk PDF » (pdfcraft.wxs). -->
  <Fragment>
    <Binary Id="LuskBanner" SourceFile="$(sys.SOURCEFILEDIR)images\banner.bmp" />
    <UI Id="PdfcraftInstallerUI">
      <TextStyle Id="InstallerNormal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="InstallerTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
      <Property Id="DefaultUIFont" Value="InstallerNormal" />

      <Dialog Id="InstallWelcome" Width="370" Height="256" Title="Installation de [ProductName]">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="LuskBanner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="20" Y="54" Width="330" Height="25" Text="{\InstallerTitle}Installer [ProductName]" />
        <Control Id="Description" Type="Text" X="20" Y="80" Width="330" Height="30" Text="[ProductName] va être installé pour tous les utilisateurs de cet ordinateur et ajouté au menu Démarrer. Cliquez sur Installer pour continuer." HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" />
        <Control Id="DescriptionUser" Type="Text" X="20" Y="80" Width="330" Height="30" Text="[ProductName] va être installé pour votre compte seulement et ajouté au menu Démarrer. Cliquez sur Installer pour continuer." HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" />
        <!-- The install folder (#1139): typed here, or picked in the browse dialog. It starts on the
             folder install-policy.wxi chose for the scope (the recorded one on an update). Install
             validates and sets it (SetTargetPath) before the dialog closes. -->
        <Control Id="InstallToLabel" Type="Text" X="20" Y="114" Width="330" Height="12" Text="&amp;Dossier d'installation :" />
        <Control Id="InstallTo" Type="PathEdit" X="20" Y="128" Width="262" Height="18" Property="INSTALLFOLDER" />
        <Control Id="Browse" Type="PushButton" X="288" Y="126" Width="62" Height="22" Text="&amp;Parcourir…">
          <Publish Event="SpawnDialog" Value="BrowseFolder" />
        </Control>
        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="156" Width="330" Height="17" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Créer un raccourci sur le &amp;Bureau" />
        <Control Id="PdfContextMenu" Type="CheckBox" X="20" Y="174" Width="330" Height="17" Property="INSTALLPDFCONTEXTMENU" CheckBoxValue="1" Text="Ajouter « &amp;Modifier » et « Combiner » au menu du clic droit des fichiers PDF" />
        <Control Id="WelcomeLine" Type="Line" X="0" Y="210" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" X="195" Y="221" Width="75" Height="23" Default="yes" DefaultCondition="ALLUSERS = 1" ElevationShield="yes" HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" Text="&amp;Installer">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="InstallUser" Type="PushButton" DefaultCondition="ALLUSERS &lt;&gt; 1" HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" X="195" Y="221" Width="75" Height="23" Text="&amp;Installer">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="221" Width="70" Height="23" Cancel="yes" Text="Annuler">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Windows Installer's own folder browser, in native controls (#1139): the drive and parent
           list, the folders at the current level, Up, New folder, and the full path to type.
           OK validates and sets the folder; Cancel puts back what the welcome dialog had. -->
      <Dialog Id="BrowseFolder" Width="370" Height="270" Title="Installation de [ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="25" Text="{\InstallerTitle}Choisir le dossier d'installation" />
        <Control Id="LookInLabel" Type="Text" X="20" Y="45" Width="100" Height="12" Text="&amp;Regarder dans :" />
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="20" Y="58" Width="215" Height="80" Property="INSTALLFOLDER" Fixed="yes" Remote="yes">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
        </Control>
        <Control Id="Up" Type="PushButton" X="245" Y="57" Width="40" Height="19" Text="&amp;Haut">
          <Publish Event="DirectoryListUp" Value="0" />
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="290" Y="57" Width="60" Height="19" Text="&amp;Nouveau dossier">
          <Publish Event="DirectoryListNew" Value="0" />
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="20" Y="82" Width="330" Height="105" Property="INSTALLFOLDER" Sunken="yes" TabSkip="no" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="195" Width="100" Height="12" Text="&amp;Nom du dossier :" />
        <Control Id="PathEdit" Type="PathEdit" X="20" Y="209" Width="330" Height="18" Property="INSTALLFOLDER" />
        <Control Id="OK" Type="PushButton" X="195" Y="237" Width="75" Height="23" Default="yes" Text="OK">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="237" Width="70" Height="23" Cancel="yes" Text="Annuler">
          <Publish Event="Reset" Value="0" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
      </Dialog>

      <Dialog Id="InstallMaintenance" Width="370" Height="180" Title="Installation de [ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Entretien de [ProductName]" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70" Text="[ProductName] est déjà installé. Choisissez Réparer pour remettre les fichiers et raccourcis manquants, ou Désinstaller pour le retirer de cet ordinateur." />
        <Control Id="Repair" Type="PushButton" X="110" Y="145" Width="75" Height="23" Default="yes" DefaultCondition="ALLUSERS = 1" ElevationShield="yes" HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" Text="&amp;Réparer">
          <Publish Property="REINSTALL" Value="ALL" Order="1" />
          <Publish Property="REINSTALLMODE" Value="amus" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="RepairUser" Type="PushButton" DefaultCondition="ALLUSERS &lt;&gt; 1" HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" X="110" Y="145" Width="75" Height="23" Text="&amp;Réparer">
          <Publish Property="REINSTALL" Value="ALL" Order="1" />
          <Publish Property="REINSTALLMODE" Value="amus" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="195" Y="145" Width="75" Height="23" ElevationShield="yes" HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" Text="&amp;Désinstaller">
          <Publish Property="REMOVE" Value="ALL" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="RemoveUser" Type="PushButton" HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" X="195" Y="145" Width="75" Height="23" Text="&amp;Désinstaller">
          <Publish Property="REMOVE" Value="ALL" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="145" Width="70" Height="23" Cancel="yes" Text="Annuler">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="InstallProgress" Width="370" Height="180" Title="Installation de [ProductName]" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Installation de [ProductName] en cours" />
        <!-- No ActionText table is authored: subscribing would blank this message (#305). -->
        <Control Id="Status" Type="Text" X="20" Y="60" Width="330" Height="40" Text="Veuillez patienter pendant la fin de l'installation." />
        <Control Id="Progress" Type="ProgressBar" X="20" Y="110" Width="330" Height="15" ProgressBlocks="yes">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="145" Width="70" Height="23" Cancel="yes" Text="Annuler">
          <Publish Event="SpawnDialog" Value="ConfirmCancel" />
        </Control>
      </Dialog>

      <Dialog Id="ConfirmCancel" Width="300" Height="110" Title="Annuler l'installation">
        <Control Id="Description" Type="Text" X="20" Y="20" Width="260" Height="35" Text="Annuler l'installation de [ProductName] ?" />
        <Control Id="Yes" Type="PushButton" X="130" Y="70" Width="70" Height="23" Text="&amp;Oui">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="210" Y="70" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Non">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallComplete" Width="370" Height="226" Title="Installation de [ProductName]">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="LuskBanner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="20" Y="54" Width="330" Height="25" Text="{\InstallerTitle}Installation terminée avec succès" />
        <Control Id="Description" Type="Text" X="20" Y="84" Width="330" Height="50" Text="Merci d'avoir choisi [ProductName], le lecteur et éditeur de PDF libre de l'association Lusk. Cliquez sur Terminer pour fermer cette fenêtre." />
        <!-- Lusk PDF : pas après une réparation ou une désinstallation. -->
        <Control Id="Launch" Type="CheckBox" X="20" Y="150" Width="330" Height="17" Property="LUSKLAUNCH" CheckBoxValue="1" Text="&amp;Lancer [ProductName]" HideCondition="Installed OR REMOVE" ShowCondition="NOT Installed AND NOT REMOVE" />
        <Control Id="Finish" Type="PushButton" X="280" Y="191" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Terminer">
          <Publish Event="DoAction" Value="LaunchLuskPdf" Order="1" Condition="LUSKLAUNCH = 1 AND NOT Installed AND NOT REMOVE" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
      </Dialog>

      <Dialog Id="InstallFailed" Width="370" Height="180" Title="Installation de [ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}L'installation a échoué" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70" Text="L'installation de [ProductName] n'a pas pu se terminer. Corrigez l'erreur signalée, puis relancez l'installation." />
        <Control Id="Finish" Type="PushButton" X="280" Y="145" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Terminer">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallCancelled" Width="370" Height="180" Title="Installation de [ProductName]">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Installation annulée" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70" Text="L'installation de [ProductName] a été annulée. Relancez-la quand vous le souhaitez." />
        <Control Id="Finish" Type="PushButton" X="280" Y="145" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Terminer">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Shown by Windows Installer (Restart Manager) when an upgrade or repair must replace files
           that a running Lusk PDF holds open. OK closes those programs (MSIRMSHUTDOWN=2) and
           continues; Cancel ends setup. -->
      <Dialog Id="MsiRMFilesInUse" Width="370" Height="200" Title="Installation de [ProductName]" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="25" Text="{\InstallerTitle}Fichiers en cours d'utilisation" />
        <Control Id="Description" Type="Text" X="20" Y="45" Width="330" Height="30" Text="Ces programmes utilisent des fichiers que l'installation doit mettre à jour. Cliquez sur OK pour les fermer et continuer, ou sur Annuler pour arrêter l'installation." />
        <Control Id="List" Type="ListBox" X="20" Y="80" Width="330" Height="55" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="OK" Type="PushButton" X="195" Y="165" Width="75" Height="23" Default="yes" Text="OK">
          <Publish Property="MSIRMSHUTDOWN" Value="2" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="165" Width="70" Height="23" Cancel="yes" Text="Annuler">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="InstallWelcome" Before="InstallMaintenance" Condition="UILevel = 5 AND NOT Installed" />
        <Show Dialog="InstallMaintenance" Before="InstallProgress" Condition="UILevel = 5 AND Installed AND NOT REMOVE AND NOT REINSTALL" />
        <Show Dialog="InstallProgress" Before="ExecuteAction" Condition="UILevel = 5" />
        <Show Dialog="InstallComplete" OnExit="success" Condition="UILevel = 5" />
        <Show Dialog="InstallFailed" OnExit="error" Condition="UILevel = 5" />
        <Show Dialog="InstallCancelled" OnExit="cancel" Condition="UILevel = 5" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
