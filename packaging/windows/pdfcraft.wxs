<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Lusk PDF (comme Lusk Texte, Tab et Diapo) : l'installateur en français, aux couleurs de Lusk.
       Un nouveau produit (UpgradeCode à lui, à ne jamais changer), qui ne remplace pas PdfCraft.
       Son éditeur est « Lusk » : la copie de craft-update (vendor/craft-update, PUBLISHERS) le
       reconnaît pour les mises à jour. -->
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Lusk PDF" Manufacturer="Lusk" Version="$(var.Version)" UpgradeCode="DF1BDDAB-0D5E-4E20-B858-F4C287CE1576" Scope="perUserOrMachine" Compressed="yes" Language="1036" Codepage="1252">
    <SummaryInformation Description="Lusk PDF, lecteur et éditeur de PDF" Manufacturer="Lusk" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- HKLM registrations must never point into a per-user installation (#305). Allow removal
         of an existing installation even if an older MSI let it install per-user. -->
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Une version plus récente de Lusk PDF est déjà installée." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="PdfcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PdfcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.lusk.bzh" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/declic29/Lusk_Pdf/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/declic29/Lusk_Pdf" />
    <!-- Lusk PDF : « Lancer Lusk PDF » sur la dernière page (case cochée), par WixShellExec
         (WixToolset.Util.wixext). Jamais dans une installation silencieuse (/qn), qui ne montre
         pas cette page. -->
    <Property Id="LUSKLAUNCH" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PdfcraftExe]" />
    <CustomAction Id="LaunchLuskPdf" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <!-- Desktop shortcut (#143): on by default for a first install, a checkbox in the full-UI
         welcome dialog, and INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended
         installs. Secure, so the choice made in the (unelevated) UI reaches the elevated install.
         An update keeps the shortcut only if it is still on the desktop (#1058): the launcher
         updates with /passive and no properties, so deleting the shortcut is the only way its
         users can say no. A value given on the command line wins. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <!-- AppSearch runs before the full-UI scope page can choose Everyone, so [DesktopFolder] still
         names the user's desktop then. Search both desktops and keep the one for the chosen scope. -->
    <Property Id="EXISTINGDESKTOPSHORTCUT_USER">
      <DirectorySearch Id="DesktopSearchUser" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="Lusk PDF.lnk" />
      </DirectorySearch>
    </Property>
    <Property Id="EXISTINGDESKTOPSHORTCUT_MACHINE">
      <DirectorySearch Id="DesktopSearchMachine" Path="[%PUBLIC]\Desktop" Depth="0">
        <FileSearch Name="Lusk PDF.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="EXISTINGDESKTOPSHORTCUT" Action="CraftExistingMachineShortcut" Value="[EXISTINGDESKTOPSHORTCUT_MACHINE]" After="CraftLoadOption2U" Sequence="first" Condition="ALLUSERS = 1 AND EXISTINGDESKTOPSHORTCUT_MACHINE" />
    <SetProperty Id="EXISTINGDESKTOPSHORTCUT" Action="CraftExistingUserShortcut" Value="[EXISTINGDESKTOPSHORTCUT_USER]" After="CraftExistingMachineShortcut" Sequence="first" Condition="ALLUSERS &lt;&gt; 1 AND EXISTINGDESKTOPSHORTCUT_USER" />
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="CraftExistingUserShortcut" Sequence="first" Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <!-- The File Explorer menus: « Modifier avec Lusk PDF » for PDF files (#682) and « Créer un PDF
         avec Lusk PDF… » for images (#190). Each is on by default for a first install and has a property
         to leave it out of unattended installs: INSTALLPDFCONTEXTMENU=0 (also a welcome-dialog
         checkbox) and INSTALLIMAGECONTEXTMENU=0. Secure, like the desktop shortcut's.
         An update keeps the installed version's choice (#305) by looking for the menu's registry
         key, the way the desktop shortcut looks for its file: AppSearch runs before the old version
         is removed. Releases from before a menu existed (the PDF one came in 0.7.1, the image one in
         0.4.0) never had the key, so updating from one of them counts as a first install; the
         OnlyDetect rows below tell them apart. A value given on the command line wins.
         Lusk PDF : every release has both menus, from the first one (1.0.0), so one row detects
         them both (two identical rows would be the same Upgrade key, which WiX refuses). -->
    <Upgrade Id="DF1BDDAB-0D5E-4E20-B858-F4C287CE1576">
      <UpgradeVersion Minimum="1.0.0" IncludeMinimum="yes" OnlyDetect="yes" Property="LUSKMENURELEASE" />
    </Upgrade>
    <Property Id="INSTALLPDFCONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGPDFCONTEXTMENU" Secure="yes">
      </Property>
    <SetProperty Id="INSTALLPDFCONTEXTMENU" Value="1" After="CraftLoadOption2U" Sequence="first" Condition="NOT INSTALLPDFCONTEXTMENU AND (NOT LUSKMENURELEASE OR EXISTINGPDFCONTEXTMENU)" />
    <Property Id="INSTALLIMAGECONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGIMAGECONTEXTMENU" Secure="yes">
      </Property>
    <SetProperty Id="INSTALLIMAGECONTEXTMENU" Value="1" After="CraftLoadOption2U" Sequence="first" Condition="NOT INSTALLIMAGECONTEXTMENU AND (NOT LUSKMENURELEASE OR EXISTINGIMAGECONTEXTMENU)" />
    <UIRef Id="PdfcraftInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Lusk">
        <Directory Id="INSTALLFOLDER" Name="Lusk PDF">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Lusk PDF" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="PdfcraftFiles" />
      <ComponentGroupRef Id="PdfcraftModels" />
    </Feature>
  <Property Id="CRAFT_OPTION_1_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_MSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Edit" Type="raw" />
    </Property><SetProperty Id="EXISTINGPDFCONTEXTMENU" Action="CraftLoadOption1M" Value="[CRAFT_OPTION_1_M]" After="LaunchConditions" Sequence="both" Condition="ALLUSERS = 1" /><Property Id="CRAFT_OPTION_1_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_USearch" Root="HKCU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Edit" Type="raw" />
    </Property><SetProperty Id="EXISTINGPDFCONTEXTMENU" Action="CraftLoadOption1U" Value="[CRAFT_OPTION_1_U]" After="CraftLoadOption1M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" /><Property Id="CRAFT_OPTION_2_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_2_MSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\LuskPdf.CreatePdf" Type="raw" />
    </Property><SetProperty Id="EXISTINGIMAGECONTEXTMENU" Action="CraftLoadOption2M" Value="[CRAFT_OPTION_2_M]" After="CraftLoadOption1U" Sequence="both" Condition="ALLUSERS = 1" /><Property Id="CRAFT_OPTION_2_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_2_USearch" Root="HKCU" Key="Software\Classes\SystemFileAssociations\.png\shell\LuskPdf.CreatePdf" Type="raw" />
    </Property><SetProperty Id="EXISTINGIMAGECONTEXTMENU" Action="CraftLoadOption2U" Value="[CRAFT_OPTION_2_U]" After="CraftLoadOption2M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" /></Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="PdfcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PdfcraftApp" Guid="379EDB3F-C7FB-4E63-81C7-5CDA327CA85C">
        <File Id="PdfcraftExe" Source="$(var.BinDir)\pdfcraft.exe" KeyPath="yes" />

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\pdfcraft.exe" Value="[#PdfcraftExe]" Type="string" />

        <!-- PDF files (#107): Lusk PDF is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             PdfCraft entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskPdf.Document" Value="Document PDF" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app's icon; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskPdf.Document\DefaultIcon" Value="&quot;[#PdfcraftExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskPdf.Document\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <!-- No overlay on thumbnails and in the preview pane: without TypeOverlay, Windows paints
             the default program's icon over the lower-right corner of every PDF
             thumbnail, covering part of the page. An empty string means none ("Thumbnail
             Handlers", Microsoft Learn). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\LuskPdf.Document" Name="TypeOverlay" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdf\OpenWithProgids" Name="LuskPdf.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\pdfcraft.exe" Name="FriendlyAppName" Value="Lusk PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\pdfcraft.exe\DefaultIcon" Value="&quot;[#PdfcraftExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\pdfcraft.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\pdfcraft.exe\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskPdf\Capabilities" Name="ApplicationName" Value="Lusk PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskPdf\Capabilities" Name="ApplicationDescription" Value="Le lecteur et éditeur de PDF libre de l'association Lusk : lire, annoter, remplir, signer et organiser vos PDF." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskPdf\Capabilities" Name="ApplicationIcon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LuskPdf\Capabilities\FileAssociations" Name=".pdf" Value="LuskPdf.Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="LuskPdf" Value="Software\LuskPdf\Capabilities" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\LuskPdf" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      <!-- Lusk : le module de mise à jour (craft-update) reconnaît une copie installée par ce MSI au
           dossier qu'il lit sous cette clé, comme pour Lusk Texte, Tab et Diapo. Le nom de la clé
           est celui que la bibliothèque lit, pas un éditeur. -->
      <RegistryValue Root="HKMU" Key="Software\Learning Machines LLC\Lusk PDF" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to pdfcraft.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. They take
           their icon from pdfcraft.exe, not the Icon table: Windows Installer keeps that copy under
           the ProductCode, which every release changes, so a taskbar pin made from a shortcut that
           named it shows a blank icon once an update removes the old release. -->
      <Component Id="PdfcraftStartMenuShortcut" Directory="ProgramMenuFolder" Guid="2AD9B5E0-9D6D-49B1-AB73-39B1534982C9">
        <Shortcut Id="StartMenuShortcut" Name="Lusk PDF" Description="Lusk PDF, lecteur et éditeur de PDF" Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\LuskPdf\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="PdfcraftDesktopShortcut" Directory="DesktopFolder" Guid="C1128309-E2F8-4B4A-99E5-0790415F5989" Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Lusk PDF" Description="Lusk PDF, lecteur et éditeur de PDF" Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\LuskPdf\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- PDF context menu (#682): « Modifier avec Lusk PDF » opens the file in Lusk PDF whichever app is
           the default for .pdf, which it leaves alone (SystemFileAssociations, like the image
           menu). Several PDFs selected (up to 15, Windows' limit for this kind of entry) start one
           launch each, and the single-instance hand-off opens them as tabs of one window. On
           Windows 11 the entry is under "Show more options": the first-level menu only takes
           packaged apps' (IExplorerCommand) entries. Its own component with an HKLM key path, so
           INSTALLPDFCONTEXTMENU=0 leaves it out and uninstall removes it. -->
      <Component Id="PdfcraftPdfContextMenu" Guid="C9DD103E-9C78-4233-A3A1-2CE980D69F3C" Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Edit" Value="Modifier avec Lusk PDF" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Edit" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Edit\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <!-- « Combiner dans Lusk PDF » (#585), on the same switch: each selected file starts one
             launch of pdfcraft.exe with the combine option, and the running Lusk PDF collects them
             into its Combine files tab (single_instance). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Combine" Value="Combiner dans Lusk PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Combine" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Combine" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LuskPdf.Combine\command" Value="&quot;[#PdfcraftExe]&quot; --combine &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Image context menu (#190): « Créer un PDF avec Lusk PDF… » opens the DPI chooser, without
           changing image file defaults. Its own component with an HKLM key path, so
           INSTALLIMAGECONTEXTMENU=0 leaves it out and uninstall removes it. These rows were in
           PdfcraftApp up to 0.7.1; moving them is safe because MajorUpgrade removes the old version
           before installing (afterInstallValidate), so no old row is left behind. -->
      <Component Id="PdfcraftImageContextMenu" Guid="9B42A9FD-BE83-4F21-9CC4-5CECF5523337" Condition="INSTALLIMAGECONTEXTMENU = 1">
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\LuskPdf.CreatePdf" Value="Créer un PDF avec Lusk PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\LuskPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\LuskPdf.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="PdfcraftCli">
        <File Id="PdfcraftCliExe" Source="$(var.BinDir)\pdfcraft-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The embedded PDF icon's ISC notice and project licences travel with the binaries. -->
      <Component Id="PdfcraftDocumentIconLicense">
        <File Id="PdfcraftDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftMitLicense">
        <File Id="PdfcraftMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftApacheLicense">
        <File Id="PdfcraftApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftNotice">
        <File Id="PdfcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <!-- Lusk PDF : l'auteur, la source et la licence de chaque image, police, dictionnaire et
           traduction. -->
      <Component Id="LuskAttribution">
        <File Id="LuskAttributionFile" Source="$(var.BinDir)\ATTRIBUTION.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside pdfcraft.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. -->
    <ComponentGroup Id="PdfcraftModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
